# ============================================================
# .env — Bimba AI Backend Configuration
# ============================================================
# NEVER commit this file to git. Add it to .gitignore.
# Fill in your real values below.
# ============================================================

APP_NAME="BIMBA AI"
DEBUG=True
PORT=8000

# ------ MongoDB Atlas ------
# Replace with your actual connection string from Atlas
MONGODB_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
DATABASE_NAME=bimba_ai

# ------ JWT Auth ------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------ AI Keys (optional for now, needed for ATS analysis) ------
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ------ CORS ------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
